@page
@model MatuTI.Pages.IndexModel
@{ViewData["Title"] = "Dashboard";}

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                    <i class="bi bi-building text-primary fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Empresas</div>
                    <div class="fs-3 fw-bold">@Model.TotalEmpresas</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-success bg-opacity-10 p-3">
                    <i class="bi bi-clipboard-check text-success fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Avaliações concluídas</div>
                    <div class="fs-3 fw-bold">@Model.TotalAvaliacoes</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-warning bg-opacity-10 p-3">
                    <i class="bi bi-question-circle text-warning fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Questões ativas</div>
                    <div class="fs-3 fw-bold">@Model.TotalQuestoes</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-info bg-opacity-10 p-3">
                    <i class="bi bi-pc-display text-info fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Ativos cadastrados</div>
                    <div class="fs-3 fw-bold">@Model.TotalAtivos</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom py-3">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-clock-history me-2 text-primary"></i>Últimas avaliações</h6>
    </div>
    <div class="card-body p-0">
        @if (!Model.UltimasAvaliacoes.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox fs-1 d-block mb-2"></i>Nenhuma avaliação concluída ainda.
                <br /><a asp-page="/Avaliacao/Iniciar" class="btn btn-primary mt-3"><i class="bi bi-plus-circle me-1"></i>Iniciar primeira avaliação</a>
            </div>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr><th>Empresa</th><th>Data</th><th>Score</th><th>Nível</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var av in Model.UltimasAvaliacoes)
                    {
                        var cor = ScoreCalculator.CorNivel(av.NivelMaturidade);
                        <tr>
                            <td class="fw-semibold">@av.Empresa.Nome</td>
                            <td class="text-muted">@av.Data.ToString("dd/MM/yyyy")</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height:8px;min-width:80px">
                                        <div class="progress-bar bg-@cor" style="width:@av.ScoreGeral.ToString("F0")%"></div>
                                    </div>
                                    <span class="fw-semibold">@av.ScoreGeral.ToString("F1")%</span>
                                </div>
                            </td>
                            <td><span class="badge bg-@cor">@av.NivelMaturidade</span></td>
                            <td>
                                <a asp-page="/Avaliacao/Relatorio" asp-route-id="@av.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-file-earmark-text me-1"></i>Relatório
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
