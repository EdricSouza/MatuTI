@page
@model MatuTI.Pages.Auth.RegistroModel
@{
    ViewData["Title"] = "Registro";
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MatuTI - Registro</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body { background: linear-gradient(135deg, #1a237e 0%, #0d47a1 100%); min-height: 100vh; }
        .card { border: none; border-radius: 16px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card p-4">
                    <div class="text-center mb-4">
                        <i class="bi bi-person-plus" style="font-size:2.5rem;color:#1a237e"></i>
                        <h4 class="mt-2 fw-bold">Nova Conta</h4>
                    </div>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Input.NomeCompleto" class="form-label fw-semibold"></label>
                            <input asp-for="Input.NomeCompleto" class="form-control" />
                            <span asp-validation-for="Input.NomeCompleto" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label fw-semibold"></label>
                            <input asp-for="Input.Email" class="form-control" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Senha" class="form-label fw-semibold"></label>
                            <input asp-for="Input.Senha" class="form-control" />
                            <span asp-validation-for="Input.Senha" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.ConfirmarSenha" class="form-label fw-semibold"></label>
                            <input asp-for="Input.ConfirmarSenha" class="form-control" />
                            <span asp-validation-for="Input.ConfirmarSenha" class="text-danger small"></span>
                        </div>

                        @if (User.IsInRole("Admin"))
                        {
                            <div class="mb-3">
                                <label asp-for="Input.Perfil" class="form-label fw-semibold"></label>
                                <select asp-for="Input.Perfil" class="form-select">
                                    <option value="Avaliador">Avaliador</option>
                                    <option value="Admin">Administrador</option>
                                </select>
                            </div>
                        }

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                            <i class="bi bi-check-circle me-2"></i>Criar conta
                        </button>
                    </form>

                    <hr />
                    <div class="text-center">
                        <a asp-page="/Auth/Login" class="text-decoration-none">
                            <i class="bi bi-arrow-left me-1"></i>Voltar ao login
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
