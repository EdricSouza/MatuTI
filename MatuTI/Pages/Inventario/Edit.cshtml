@page "{id:int}"
@model MatuTI.Pages.Inventario.EditModel
@{ViewData["Title"] = "Editar Ativo";}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form method="post">
                    <input type="hidden" asp-for="Ativo.Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Ativo.EmpresaId" class="form-label fw-semibold">Empresa</label>
                            <select asp-for="Ativo.EmpresaId" asp-items="Model.EmpresasList" class="form-select">
                                <option value="">-- Selecione --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Ativo.Tipo" class="form-label fw-semibold"></label>
                            <select asp-for="Ativo.Tipo" class="form-select">
                                <option value="">-- Selecione --</option>
                                <option value="Hardware">Hardware</option>
                                <option value="Software">Software</option>
                                <option value="Cloud">Cloud / SaaS</option>
                                <option value="Rede">Rede / Infraestrutura</option>
                                <option value="Outro">Outro</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label asp-for="Ativo.Nome" class="form-label fw-semibold"></label>
                            <input asp-for="Ativo.Nome" class="form-control" placeholder="Ex: Servidor Web Principal, Windows Server 2022..." />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Ativo.Fabricante" class="form-label fw-semibold"></label>
                            <input asp-for="Ativo.Fabricante" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Ativo.Versao" class="form-label fw-semibold"></label>
                            <input asp-for="Ativo.Versao" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Ativo.Localizacao" class="form-label fw-semibold"></label>
                            <select asp-for="Ativo.Localizacao" class="form-select">
                                <option value="">-- Selecione --</option>
                                <option value="On-premise">On-premise</option>
                                <option value="Cloud">Cloud</option>
                                <option value="Híbrido">Híbrido</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Ativo.Responsavel" class="form-label fw-semibold"></label>
                            <input asp-for="Ativo.Responsavel" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Ativo.DataAquisicao" class="form-label fw-semibold"></label>
                            <input asp-for="Ativo.DataAquisicao" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Ativo.FimSuporte" class="form-label fw-semibold"></label>
                            <input asp-for="Ativo.FimSuporte" type="date" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label asp-for="Ativo.Observacoes" class="form-label fw-semibold"></label>
                            <textarea asp-for="Ativo.Observacoes" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="Ativo.Critico" class="form-check-input" />
                                <label asp-for="Ativo.Critico" class="form-check-label fw-semibold">Ativo crítico para o negócio</label>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex gap-2 justify-content-end mt-4">
                        <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle me-1"></i>Salvar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
