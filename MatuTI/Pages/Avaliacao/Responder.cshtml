@page "{id:int}"
@model MatuTI.Pages.Avaliacao.ResponderModel
@{
    ViewData["Title"] = "Responder Avaliação";
}

<div class="mb-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body py-3 px-4">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-building text-primary fs-4"></i>
                <div>
                    <div class="fw-bold fs-5">@Model.Avaliacao.Empresa.Nome</div>
                    <div class="text-muted small">Iniciada em @Model.Avaliacao.Data.ToString("dd/MM/yyyy HH:mm") por @Model.Avaliacao.AplicadaPorNome</div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Sucesso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form method="post" asp-page-handler="Salvar" asp-route-id="@Model.Avaliacao.Id">
    @for (int i = 0; i < Model.Inputs.Count; i++)
    {
        <input type="hidden" asp-for="Inputs[i].RespostaId" />
    }

    @foreach (var grupo in Model.RespostasPorIndicador)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-primary text-white py-3">
                <h6 class="mb-0 fw-semibold">
                    <i class="bi bi-tag me-2"></i>@grupo.Key
                </h6>
            </div>
            <div class="card-body p-0">
                @foreach (var resposta in grupo)
                {
                    var idx = Model.Inputs.FindIndex(x => x.RespostaId == resposta.Id);
                    <div class="border-bottom p-4 questao-item" id="questao-@resposta.Id">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div class="flex-grow-1">
                                <p class="mb-2 fw-semibold">
                                    @resposta.Questao.Texto
                                    @for (int p = 0; p < resposta.Questao.Peso; p++)
                                    {
                                        <i class="bi bi-star-fill text-warning ms-1" style="font-size:0.7rem"></i>
                                    }
                                </p>

                                <div class="d-flex gap-3 mb-3 resposta-opcoes">
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input resposta-radio"
                                               type="radio"
                                               name="Inputs[@idx].Sim"
                                               id="sim-@resposta.Id"
                                               value="true"
                                               data-id="@resposta.Id"
                                               @(Model.Inputs[idx].Sim ? "checked" : "") />
                                        <label class="form-check-label text-success fw-semibold" for="sim-@resposta.Id">
                                            <i class="bi bi-check-circle me-1"></i>SIM
                                        </label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input resposta-radio"
                                               type="radio"
                                               name="Inputs[@idx].Sim"
                                               id="nao-@resposta.Id"
                                               value="false"
                                               data-id="@resposta.Id"
                                               @(!Model.Inputs[idx].Sim ? "checked" : "") />
                                        <label class="form-check-label text-danger fw-semibold" for="nao-@resposta.Id">
                                            <i class="bi bi-x-circle me-1"></i>NÃO
                                        </label>
                                    </div>
                                </div>

                                <div class="evidencia-box-@resposta.Id" style="display:@(Model.Inputs[idx].Sim ? "block" : "none")">
                                    <label class="form-label small fw-semibold text-success">
                                        <i class="bi bi-check2-square me-1"></i>Evidência (obrigatória para SIM)
                                    </label>
                                    <textarea name="Inputs[@idx].Evidencia"
                                              class="form-control form-control-sm"
                                              rows="2"
                                              placeholder="Descreva a evidência que comprova esta resposta...">@Model.Inputs[idx].Evidencia</textarea>
                                </div>

                                <div class="providencia-box-@resposta.Id" style="display:@(!Model.Inputs[idx].Sim ? "block" : "none")">
                                    <label class="form-label small fw-semibold text-danger">
                                        <i class="bi bi-exclamation-triangle me-1"></i>Providência / Plano de ação (obrigatória para NÃO)
                                    </label>
                                    <textarea name="Inputs[@idx].Providencia"
                                              class="form-control form-control-sm"
                                              rows="2"
                                              placeholder="Descreva o plano de ação para corrigir esta lacuna...">@Model.Inputs[idx].Providencia</textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body d-flex justify-content-between align-items-center py-3 form-actions">
            <button type="submit" class="btn btn-outline-secondary">
                <i class="bi bi-save me-1"></i>Salvar rascunho
            </button>
            <button type="submit" asp-page-handler="Salvar" asp-route-concluir="true" class="btn btn-success btn-lg"
                    onclick="return confirm('Deseja concluir e gerar o relatório? Não será possível editar após a conclusão.')">
                <i class="bi bi-flag-fill me-2"></i>Concluir e gerar relatório
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        document.querySelectorAll('.resposta-radio').forEach(radio => {
            radio.addEventListener('change', function () {
                const id = this.dataset.id;
                const isSim = this.value === 'true';
                document.querySelector(`.evidencia-box-${id}`).style.display = isSim ? 'block' : 'none';
                document.querySelector(`.providencia-box-${id}`).style.display = isSim ? 'none' : 'block';
            });
        });
    </script>
}
