@page "{id:int}"
@model MatuTI.Pages.Avaliacao.RelatorioModel
@{
    ViewData["Title"] = "Relatório de Maturidade";
}

<!-- Cabeçalho -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="row align-items-center">
            <div class="col-md-8">
                <div class="text-muted small text-uppercase fw-semibold mb-1">Relatório de Avaliação de Maturidade de TI</div>
                <h3 class="fw-bold mb-1">@Model.Avaliacao.Empresa.Nome</h3>
                <div class="text-muted">
                    <i class="bi bi-calendar3 me-1"></i>@Model.Avaliacao.Data.ToString("dd/MM/yyyy HH:mm")
                    &nbsp;&bull;&nbsp;<i class="bi bi-person me-1"></i>@Model.Avaliacao.AplicadaPorNome
                </div>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <button onclick="window.print()" class="btn btn-outline-secondary"><i class="bi bi-printer me-1"></i>Imprimir</button>
            </div>
        </div>
    </div>
</div>

<!-- Score geral e nível -->
<div class="row g-4 mb-4">
    <div class="col-md-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4 text-center">
                <div class="text-muted small text-uppercase fw-semibold mb-2">Score Geral</div>
                <div class="display-3 fw-bold text-@Model.CorNivel">@Model.ScoreGeral.ToString("F1")<span class="fs-3">%</span></div>
                <div class="progress mt-3" style="height:12px;border-radius:6px">
                    <div class="progress-bar bg-@Model.CorNivel" style="width:@Model.ScoreGeral.ToString("F0")%;border-radius:6px"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="text-muted small text-uppercase fw-semibold mb-2">Nível de Maturidade</div>
                <span class="badge bg-@Model.CorNivel fs-5 px-4 py-2 mb-3">@Model.NivelMaturidade</span>
                <p class="text-muted mb-0">@Model.DescricaoNivel</p>
            </div>
        </div>
    </div>
</div>

<!-- NC1 — Score + Capacidade COBIT por indicador -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-bottom py-3">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-bar-chart me-2 text-primary"></i>Score por Indicador — Capacidade COBIT (0–5)</h6>
    </div>
    <div class="card-body p-4">
        @foreach (var item in Model.ScoresPorIndicador)
        {
            var cor = ScoreCalculator.CorNivel(ScoreCalculator.NivelMaturidade(item.Value));
            var cap = Model.CapacidadePorIndicador[item.Key];
            <div class="mb-3">
                <div class="d-flex justify-content-between mb-1">
                    <span class="fw-semibold small">@item.Key</span>
                    <div>
                        <span class="badge bg-secondary me-2">Nível COBIT: @cap/5</span>
                        <span class="small fw-bold text-@cor">@item.Value.ToString("F1")% — @ScoreCalculator.NivelMaturidade(item.Value)</span>
                    </div>
                </div>
                <div class="progress" style="height:10px;border-radius:5px">
                    <div class="progress-bar bg-@cor" style="width:@item.Value.ToString("F0")%;border-radius:5px"></div>
                </div>
                <div class="text-muted" style="font-size:0.75rem">@ScoreCalculator.DescricaoCapacidade(cap)</div>
            </div>
        }
    </div>
</div>

<!-- Pontos fortes -->
@if (Model.Pontos.Any())
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom py-3">
            <h6 class="mb-0 fw-semibold text-success"><i class="bi bi-check-circle me-2"></i>Pontos Fortes (@Model.Pontos.Count)</h6>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr><th>Indicador</th><th>Questão</th><th>Evidência</th><th>Arquivo</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Pontos)
                    {
                        <tr>
                            <td><span class="badge bg-success-subtle text-success border border-success-subtle">@r.Questao.Indicador</span></td>
                            <td class="small">@r.Questao.Texto</td>
                            <td class="small text-muted">@(string.IsNullOrWhiteSpace(r.Evidencia) ? "—" : r.Evidencia)</td>
                            <td>
                                @if (!string.IsNullOrEmpty(r.EvidenciaArquivo))
                                {
                                    <a href="/uploads/@r.EvidenciaArquivo" target="_blank" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-paperclip"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- NC3 + NC8 — Lacunas com plano de ação estruturado e sugestões -->
@if (Model.Lacunas.Any())
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom py-3">
            <h6 class="mb-0 fw-semibold text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Lacunas e Planos de Ação (@Model.Lacunas.Count)</h6>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr><th>Indicador</th><th>Questão</th><th>Providência</th><th>Responsável</th><th>Prazo</th><th>Status</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Lacunas)
                    {
                        var statusCor = r.PlanoStatus switch { "Concluído" => "success", "Em andamento" => "warning", _ => "secondary" };
                        <tr>
                            <td><span class="badge bg-danger-subtle text-danger border border-danger-subtle">@r.Questao.Indicador</span></td>
                            <td class="small">@r.Questao.Texto</td>
                            <td class="small">
                                @(string.IsNullOrWhiteSpace(r.Providencia) ? "—" : r.Providencia)
                                @if (string.IsNullOrWhiteSpace(r.Providencia))
                                {
                                    <div class="text-info small mt-1">
                                        <i class="bi bi-lightbulb me-1"></i><em>@ScoreCalculator.SugestaoGAP(r.Questao.Indicador)</em>
                                    </div>
                                }
                            </td>
                            <td class="small">@(r.PlanoResponsavel ?? "—")</td>
                            <td class="small">@(r.PlanoPrazo?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td><span class="badge bg-@statusCor">@r.PlanoStatus</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- NC9 — Histórico de maturidade -->
@if (Model.HistoricoAvaliacoes.Any())
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom py-3">
            <h6 class="mb-0 fw-semibold"><i class="bi bi-graph-up me-2 text-primary"></i>Evolução da Maturidade — @Model.Avaliacao.Empresa.Nome</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm mb-3">
                    <thead class="table-light">
                        <tr>
                            <th>Data</th>
                            <th>Score</th>
                            <th>Nível</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var av in Model.HistoricoAvaliacoes)
                        {
                            var c = ScoreCalculator.CorNivel(av.NivelMaturidade);
                            <tr>
                                <td>@av.Data.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height:8px;min-width:80px">
                                            <div class="progress-bar bg-@c" style="width:@av.ScoreGeral.ToString("F0")%"></div>
                                        </div>
                                        @av.ScoreGeral.ToString("F1")%
                                    </div>
                                </td>
                                <td><span class="badge bg-@c">@av.NivelMaturidade</span></td>
                                <td><a asp-page="Relatorio" asp-route-id="@av.Id" class="btn btn-sm btn-outline-secondary">Ver</a></td>
                            </tr>
                        }
                        <tr class="table-active fw-bold">
                            <td>@Model.Avaliacao.Data.ToString("dd/MM/yyyy") (atual)</td>
                            <td>@Model.ScoreGeral.ToString("F1")%</td>
                            <td><span class="badge bg-@Model.CorNivel">@Model.NivelMaturidade</span></td>
                            <td></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            @{
                var historico = Model.HistoricoAvaliacoes.Select(a => new { Data = a.Data.ToString("dd/MM/yy"), Score = a.ScoreGeral }).ToList();
                historico.Add(new { Data = Model.Avaliacao.Data.ToString("dd/MM/yy"), Score = Model.ScoreGeral });
                var labels = string.Join(",", historico.Select(h => $"'{h.Data}'"));
                var scores = string.Join(",", historico.Select(h => h.Score.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)));
            }
            <canvas id="chartEvolucao" height="80"></canvas>
            <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
            <script>
                new Chart(document.getElementById('chartEvolucao'), {
                    type: 'line',
                    data: {
                        labels: [@Html.Raw(labels)],
                        datasets: [{ label: 'Score de Maturidade (%)', data: [@Html.Raw(scores)],
                            borderColor: '#0d6efd', backgroundColor: 'rgba(13,110,253,0.1)',
                            tension: 0.3, fill: true, pointRadius: 5 }]
                    },
                    options: { scales: { y: { min: 0, max: 100 } }, plugins: { legend: { display: false } } }
                });
            </script>
        </div>
    </div>
}

<!-- Referência dos níveis -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-bottom py-3">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-info-circle me-2 text-primary"></i>Referência dos Níveis</h6>
    </div>
    <div class="card-body">
        <div class="row g-3">
            @foreach (var nivel in new[] { "Artesanal","Eficiente","Eficaz","Estratégico" })
            {
                var cor = ScoreCalculator.CorNivel(nivel);
                var ativo = nivel == Model.NivelMaturidade;
                <div class="col-md-3">
                    <div class="card h-100 border-@cor @(ativo ? "bg-"+cor+" bg-opacity-10" : "")">
                        <div class="card-body p-3">
                            <span class="badge bg-@cor mb-2">@nivel</span>
                            <p class="small text-muted mb-0">@ScoreCalculator.DescricaoNivel(nivel)</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="d-flex justify-content-between">
    <a asp-page="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Voltar</a>
    <button onclick="window.print()" class="btn btn-primary"><i class="bi bi-printer me-1"></i>Imprimir relatório</button>
</div>

@section Scripts {
    <style>
        @@media print {
            .sidebar, .topbar, button, a.btn { display: none !important; }
            .main-content { margin-left: 0 !important; }
        }
    </style>
}
