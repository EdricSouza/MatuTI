@page "{id:int}"
@model MatuTI.Pages.Avaliacao.RelatorioModel
@{
    ViewData["Title"] = "Relatório de Maturidade";
}

<!-- Cabeçalho do relatório -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="row align-items-center">
            <div class="col-md-8">
                <div class="text-muted small text-uppercase fw-semibold mb-1">Relatório de Avaliação de Maturidade de TI</div>
                <h3 class="fw-bold mb-1">@Model.Avaliacao.Empresa.Nome</h3>
                <div class="text-muted">
                    <i class="bi bi-calendar3 me-1"></i>@Model.Avaliacao.Data.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("pt-BR"))
                    &nbsp;&bull;&nbsp;
                    <i class="bi bi-person me-1"></i>@Model.Avaliacao.AplicadaPorNome
                </div>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <button onclick="window.print()" class="btn btn-outline-secondary">
                    <i class="bi bi-printer me-1"></i>Imprimir
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Score geral e nível -->
<div class="row g-4 mb-4">
    <div class="col-md-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4 text-center d-flex flex-column justify-content-center">
                <div class="text-muted small text-uppercase fw-semibold mb-3">Score Geral</div>
                <div class="display-3 fw-bold text-@Model.CorNivel">@Model.ScoreGeral.ToString("F1")<span class="fs-3">%</span></div>
                <div class="mt-3">
                    <div class="progress" style="height:12px;border-radius:6px">
                        <div class="progress-bar bg-@Model.CorNivel"
                             style="width:@Model.ScoreGeral.ToString("F0")%;border-radius:6px"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card border-0 shadow-sm h-100 border-@Model.CorNivel" style="border-left: 5px solid !important">
            <div class="card-body p-4">
                <div class="text-muted small text-uppercase fw-semibold mb-2">Nível de Maturidade</div>
                <div class="d-flex align-items-center gap-3 mb-3">
                    <span class="badge bg-@Model.CorNivel fs-5 px-4 py-2">@Model.NivelMaturidade</span>
                </div>
                <p class="text-muted mb-0">@Model.DescricaoNivel</p>
            </div>
        </div>
    </div>
</div>

<!-- Scores por indicador -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-bottom py-3">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-bar-chart me-2 text-primary"></i>Score por Indicador</h6>
    </div>
    <div class="card-body p-4">
        @foreach (var item in Model.ScoresPorIndicador)
        {
            var cor = ScoreCalculator.CorNivel(ScoreCalculator.NivelMaturidade(item.Value));
            <div class="mb-3">
                <div class="d-flex justify-content-between mb-1">
                    <span class="fw-semibold small">@item.Key</span>
                    <span class="small fw-bold text-@cor">@item.Value.ToString("F1")% — @ScoreCalculator.NivelMaturidade(item.Value)</span>
                </div>
                <div class="progress" style="height:10px;border-radius:5px">
                    <div class="progress-bar bg-@cor" style="width:@item.Value.ToString("F0")%;border-radius:5px"></div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Pontos fortes -->
@if (Model.Pontos.Any())
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom py-3">
            <h6 class="mb-0 fw-semibold text-success">
                <i class="bi bi-check-circle me-2"></i>Pontos Fortes (@Model.Pontos.Count)
            </h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 table-mobile-stack">
                    <thead class="table-light">
                        <tr>
                            <th style="width:220px">Indicador</th>
                            <th>Questão</th>
                            <th>Evidência registrada</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Pontos)
                        {
                            <tr>
                                <td data-label="Indicador"><span class="badge bg-success-subtle text-success border border-success-subtle">@r.Questao.Indicador</span></td>
                                <td class="small" data-label="Questão">@r.Questao.Texto</td>
                                <td class="small text-muted fst-italic" data-label="Evidência registrada">
                                    @if (!string.IsNullOrWhiteSpace(r.Evidencia))
                                    {
                                        @r.Evidencia
                                    }
                                    else
                                    {
                                        <span class="text-warning">Evidência não informada</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Lacunas e planos de ação -->
@if (Model.Lacunas.Any())
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom py-3">
            <h6 class="mb-0 fw-semibold text-danger">
                <i class="bi bi-exclamation-triangle me-2"></i>Lacunas e Planos de Ação (@Model.Lacunas.Count)
            </h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 table-mobile-stack">
                    <thead class="table-light">
                        <tr>
                            <th style="width:220px">Indicador</th>
                            <th>Questão</th>
                            <th>Providência / Plano de ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Lacunas)
                        {
                            <tr>
                                <td data-label="Indicador"><span class="badge bg-danger-subtle text-danger border border-danger-subtle">@r.Questao.Indicador</span></td>
                                <td class="small" data-label="Questão">@r.Questao.Texto</td>
                                <td class="small text-muted fst-italic" data-label="Providência / Plano de ação">
                                    @if (!string.IsNullOrWhiteSpace(r.Providencia))
                                    {
                                        @r.Providencia
                                    }
                                    else
                                    {
                                        <span class="text-warning">Providência não informada</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Referência dos níveis -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-bottom py-3">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-info-circle me-2 text-primary"></i>Referência dos Níveis de Maturidade</h6>
    </div>
    <div class="card-body">
        <div class="row g-3">
            @foreach (var nivel in new[] { "Artesanal", "Eficiente", "Eficaz", "Estratégico" })
            {
                var cor = ScoreCalculator.CorNivel(nivel);
                var ativo = nivel == Model.NivelMaturidade;
                <div class="col-md-3">
                    <div class="card h-100 border-@cor @(ativo ? "bg-"+cor+" bg-opacity-10" : "")">
                        <div class="card-body p-3">
                            <span class="badge bg-@cor mb-2">@nivel</span>
                            <p class="small text-muted mb-0">@ScoreCalculator.DescricaoNivel(nivel)</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="d-flex justify-content-between page-toolbar">
    <a asp-page="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Voltar às avaliações
    </a>
    <button onclick="window.print()" class="btn btn-primary">
        <i class="bi bi-printer me-1"></i>Imprimir relatório
    </button>
</div>

@section Scripts {
    <style>
        @@media print {
            .sidebar, .topbar, button, a.btn { display: none !important; }
            .main-content { margin-left: 0 !important; }
        }
    </style>
}
