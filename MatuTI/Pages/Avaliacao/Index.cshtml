@page
@model MatuTI.Pages.Avaliacao.IndexModel
@{
    ViewData["Title"] = "Avaliações";
}

<div class="d-flex justify-content-between align-items-center mb-4 page-toolbar">
    <p class="text-muted mb-0">@Model.Avaliacoes.Count avaliação(ões) registrada(s)</p>
    <a asp-page="Iniciar" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Nova Avaliação
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (!Model.Avaliacoes.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-clipboard fs-1 d-block mb-2"></i>
                Nenhuma avaliação iniciada ainda.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 table-mobile-stack">
                    <thead class="table-light">
                        <tr>
                            <th>Empresa</th>
                            <th>Data</th>
                            <th>Aplicada por</th>
                            <th>Score</th>
                            <th>Nível</th>
                            <th>Status</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var av in Model.Avaliacoes)
                        {
                            var cor = ScoreCalculator.CorNivel(av.NivelMaturidade);
                            <tr>
                                <td class="fw-semibold" data-label="Empresa">@av.Empresa.Nome</td>
                                <td class="text-muted" data-label="Data">@av.Data.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-muted" data-label="Aplicada por">@av.AplicadaPorNome</td>
                                <td data-label="Score">
                                    @if (av.Concluida)
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height:8px;min-width:70px">
                                                <div class="progress-bar bg-@cor" style="width:@av.ScoreGeral.ToString("F0")%"></div>
                                            </div>
                                            <span class="fw-semibold">@av.ScoreGeral.ToString("F1")%</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td data-label="Nível">
                                    @if (av.Concluida)
                                    {
                                        <span class="badge bg-@cor">@av.NivelMaturidade</span>
                                    }
                                </td>
                                <td data-label="Status">
                                    @if (av.Concluida)
                                    {
                                        <span class="badge bg-success">Concluída</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Em andamento</span>
                                    }
                                </td>
                                <td data-label="Ações">
                                    @if (av.Concluida)
                                    {
                                        <a asp-page="Relatorio" asp-route-id="@av.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-file-earmark-text me-1"></i>Relatório
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-page="Responder" asp-route-id="@av.Id"
                                           class="btn btn-sm btn-outline-warning">
                                            <i class="bi bi-pencil me-1"></i>Continuar
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
