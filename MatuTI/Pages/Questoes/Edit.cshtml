@page "{id:int}"
@model MatuTI.Pages.Questoes.EditModel
@{
    ViewData["Title"] = "Editar Questão";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form method="post">
                    <input type="hidden" asp-for="Questao.Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Questao.Indicador" class="form-label fw-semibold"></label>
                        <select asp-for="Questao.Indicador" asp-items="Model.IndicadoresList" class="form-select">
                            <option value="">-- Selecione --</option>
                        </select>
                        <span asp-validation-for="Questao.Indicador" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Questao.Texto" class="form-label fw-semibold"></label>
                        <textarea asp-for="Questao.Texto" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Questao.Texto" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Questao.Peso" class="form-label fw-semibold">Peso</label>
                        <select asp-for="Questao.Peso" class="form-select">
                            <option value="1">1 - Baixo</option>
                            <option value="2">2 - Médio</option>
                            <option value="3">3 - Alto</option>
                        </select>
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-1"></i>Salvar alterações
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
