@page
@model MatuTI.Pages.Questoes.CreateModel
@{
    ViewData["Title"] = "Nova Questão";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Questao.Indicador" class="form-label fw-semibold"></label>
                        <select asp-for="Questao.Indicador" asp-items="Model.IndicadoresList"
                                class="form-select">
                            <option value="">-- Selecione um indicador --</option>
                        </select>
                        <span asp-validation-for="Questao.Indicador" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Questao.Texto" class="form-label fw-semibold"></label>
                        <textarea asp-for="Questao.Texto" class="form-control" rows="3"
                                  placeholder="Digite a pergunta..."></textarea>
                        <span asp-validation-for="Questao.Texto" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Questao.Peso" class="form-label fw-semibold">
                            Peso <span class="text-muted fw-normal">(1 = baixo, 2 = médio, 3 = alto)</span>
                        </label>
                        <select asp-for="Questao.Peso" class="form-select">
                            <option value="1">1 - Baixo</option>
                            <option value="2">2 - Médio</option>
                            <option value="3">3 - Alto</option>
                        </select>
                    </div>

                    <div class="d-flex gap-2 justify-content-end form-actions">
                        <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-1"></i>Salvar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
