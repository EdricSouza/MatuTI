@page "{id:int}"
@model MatuTI.Pages.Empresas.EditModel
@{
    ViewData["Title"] = "Editar Empresa";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form method="post">
                    <input type="hidden" asp-for="Empresa.Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Empresa.Nome" class="form-label fw-semibold"></label>
                        <input asp-for="Empresa.Nome" class="form-control" />
                        <span asp-validation-for="Empresa.Nome" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Empresa.CNPJ" class="form-label fw-semibold"></label>
                        <input asp-for="Empresa.CNPJ" class="form-control" />
                        <span asp-validation-for="Empresa.CNPJ" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Empresa.Setor" class="form-label fw-semibold"></label>
                            <input asp-for="Empresa.Setor" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Empresa.Responsavel" class="form-label fw-semibold"></label>
                            <input asp-for="Empresa.Responsavel" class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Empresa.Email" class="form-label fw-semibold"></label>
                            <input asp-for="Empresa.Email" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Empresa.Telefone" class="form-label fw-semibold"></label>
                            <input asp-for="Empresa.Telefone" class="form-control" />
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-1"></i>Salvar alterações
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
